{
  "info": {
    "name": "Kigali Clinic Quiz",
    "_postman_id": "kigali-clinic-quiz-001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "doctorId", "value": "", "description": "Paste a doctor id from a save response" },
    { "key": "patientId", "value": "", "description": "Paste a patient id from a save response" },
    { "key": "officeId", "value": "", "description": "Paste an office id from a save response" },
    { "key": "specId", "value": "", "description": "Paste a specialization id from a save response" }
  ],
  "item": [
    {
      "name": "Step0 - Save Specialization",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/specializations/save", "host": ["{{baseUrl}}"], "path": ["api", "specializations", "save"] },
        "body": { "mode": "raw", "raw": "{\"name\": \"Cardiology\"}", "options": { "raw": { "language": "json" } } }
      }
    },
    {
      "name": "Step0 - Save Office",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/offices/save", "host": ["{{baseUrl}}"], "path": ["api", "offices", "save"] },
        "body": { "mode": "raw", "raw": "{\"name\": \"Room A\", \"officeNumber\": 101}", "options": { "raw": { "language": "json" } } }
      }
    },
    {
      "name": "Step0 - Save Doctor",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/doctors/save", "host": ["{{baseUrl}}"], "path": ["api", "doctors", "save"] },
        "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Habimana\",\n  \"dateOfBirth\": \"1980-05-12\",\n  \"office\": { \"id\": \"{{officeId}}\" },\n  \"specializations\": [{ \"id\": \"{{specId}}\" }]\n}", "options": { "raw": { "language": "json" } } }
      }
    },
    {
      "name": "Step0 - Save Patient",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/patients/save", "host": ["{{baseUrl}}"], "path": ["api", "patients", "save"] },
        "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Eric\",\n  \"lastName\": \"Uwase\",\n  \"dateOfBirth\": \"2000-03-14\"\n}", "options": { "raw": { "language": "json" } } }
      }
    },
    {
      "name": "Step0-A4 - Save Appointment",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/appointments/save", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "save"] },
        "body": { "mode": "raw", "raw": "{\n  \"appointmentDate\": \"2026-10-05\",\n  \"reason\": \"Checkup\",\n  \"status\": \"SCHEDULED\",\n  \"patient\": { \"id\": \"{{patientId}}\" },\n  \"doctor\": { \"id\": \"{{doctorId}}\" }\n}", "options": { "raw": { "language": "json" } } }
      }
    },
    {
      "name": "A1 - Patients by last name",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/patients/by-last-name?lastName=uwase", "host": ["{{baseUrl}}"], "path": ["api", "patients", "by-last-name"], "query": [{ "key": "lastName", "value": "uwase" }] }
      }
    },
    {
      "name": "A2 - Appointments by status",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/appointments/by-status?status=SCHEDULED", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "by-status"], "query": [{ "key": "status", "value": "SCHEDULED" }] }
      }
    },
    {
      "name": "A3 - Appointments between dates",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/appointments/between?start=2026-10-01&end=2026-10-31", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "between"], "query": [{ "key": "start", "value": "2026-10-01" }, { "key": "end", "value": "2026-10-31" }] }
      }
    },
    {
      "name": "B1 - Doctors by specialization",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/doctors/by-specialization?name=cardiology", "host": ["{{baseUrl}}"], "path": ["api", "doctors", "by-specialization"], "query": [{ "key": "name", "value": "cardiology" }] }
      }
    },
    {
      "name": "B2 - Doctors without office",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/doctors/without-office", "host": ["{{baseUrl}}"], "path": ["api", "doctors", "without-office"] }
      }
    },
    {
      "name": "B3 - Unused specializations",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/specializations/unused", "host": ["{{baseUrl}}"], "path": ["api", "specializations", "unused"] }
      }
    },
    {
      "name": "B4 - Patients of doctor",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/patients/of-doctor/{{doctorId}}", "host": ["{{baseUrl}}"], "path": ["api", "patients", "of-doctor", "{{doctorId}}"] }
      }
    },
    {
      "name": "C1 - Stats by status",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/appointments/stats/by-status", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "stats", "by-status"] }
      }
    },
    {
      "name": "C2 - Frequent patients",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/patients/frequent?min=3", "host": ["{{baseUrl}}"], "path": ["api", "patients", "frequent"], "query": [{ "key": "min", "value": "3" }] }
      }
    },
    {
      "name": "C3 - Busiest office",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/offices/busiest", "host": ["{{baseUrl}}"], "path": ["api", "offices", "busiest"] }
      }
    },
    {
      "name": "C4 - Cancel day",
      "request": {
        "method": "PATCH",
        "url": { "raw": "{{baseUrl}}/api/appointments/cancel-day?doctorId={{doctorId}}&date=2026-10-20", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "cancel-day"], "query": [{ "key": "doctorId", "value": "{{doctorId}}" }, { "key": "date", "value": "2026-10-20" }] }
      }
    },
    {
      "name": "Bonus - Appointments page",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/appointments/page?page=0&size=5&sort=appointmentDate,desc", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "page"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "5" }, { "key": "sort", "value": "appointmentDate,desc" }] }
      }
    },
    {
      "name": "Bonus - Delete cancelled before",
      "request": {
        "method": "DELETE",
        "url": { "raw": "{{baseUrl}}/api/appointments/cancelled-before?date=2026-10-15", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "cancelled-before"], "query": [{ "key": "date", "value": "2026-10-15" }] }
      }
    }
  ]
}
